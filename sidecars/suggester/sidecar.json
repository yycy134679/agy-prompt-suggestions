{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "env": {
    "AGPS_VERSION": "1.2.0"
  },
  "restart_policy": "always",
  "display_name": "Prompt Suggestions",
  "description": "输入框下一句预测（Ghost Text + Tab 补全）后台服务与模型配置面板。",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "下一句预测",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "下一句预测"
      }
    ]
  }
}
